<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema de Hotel</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS principal do projeto -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- CSS gerado pelo projeto -->
    <link rel="stylesheet" href="~/ProjetoMVC.styles.css" asp-append-version="true" />

    <!-- CSS específico de cada página -->
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- =========================
         NAVBAR
         ========================= -->

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container">

                <!-- Logo / Nome do sistema -->
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    🏨 Sistema de Hotel

                </a>

                <!-- Botão mobile -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Menu -->
                <div class="collapse navbar-collapse"
                     id="navbarPrincipal">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Home -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Início

                            </a>

                        </li>

                        <!-- Quartos -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Quarto"
                               asp-action="Index">

                                Quartos

                            </a>

                        </li>

                        <!-- Hospedes -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Hospede"
                               asp-action="Index">

                                Hóspedes

                            </a>

                        </li>

                        <!-- Reservas -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Reserva"
                               asp-action="Index">

                                Reservas

                            </a>

                        </li>

                    </ul>

                    <!-- Lado direito da navbar -->

                    <div class="d-flex">

                        <a class="btn btn-outline-light btn-sm"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">

                            Privacidade

                        </a>

                    </div>

                </div>

            </div>

        </nav>
    </header>


    <!-- =========================
         CONTEÚDO PRINCIPAL
         ========================= -->

    <main role="main">

        <div class="container py-4">

            @RenderBody()

        </div>

    </main>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="bg-dark text-light mt-5">

        <div class="container py-4">

            <div class="row">

                <!-- Informações -->

                <div class="col-md-6">

                    <h5 class="fw-bold">
                        🏨 Sistema de Hotel
                    </h5>

                    <p class="text-secondary mb-0">
                        Sistema de gerenciamento hoteleiro.
                    </p>

                </div>

                <!-- Links -->

                <div class="col-md-6 text-md-end">

                    <a class="text-light text-decoration-none me-3"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        Início

                    </a>

                    <a class="text-light text-decoration-none"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">

                        Privacidade

                    </a>

                </div>

            </div>

            <hr class="border-secondary" />

            <div class="text-center text-secondary">

                &copy; 2026 - Sistema de Hotel

            </div>

        </div>

    </footer>


    <!-- =========================
         SCRIPTS
         ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>