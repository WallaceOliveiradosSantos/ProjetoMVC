@model IEnumerable<ProjetoMVC.Models.Curso>

@{
    ViewData["Title"] = "Gestão de Cursos";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold text-dark mb-0">🏫 Gestão de Cursos</h2>
        <small class="text-muted">Lista de disciplinas e turmas cadastradas</small>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm fw-bold">
        + Criar Novo Curso
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.Nome)</th>
                        <th>Carga Horária</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">
                                @Html.DisplayFor(modelItem => item.Nome)
                            </td>
                            <td>
                                <span class="badge bg-info text-dark fs-6">
                                    @Html.DisplayFor(modelItem => item.CargaHoraria) horas
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-warning me-1">
                                    Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-info me-1">
                                    Detalhes
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-danger">
                                    Excluir
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>