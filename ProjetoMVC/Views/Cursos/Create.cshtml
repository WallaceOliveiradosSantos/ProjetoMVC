@model ProjetoMVC.Models.Curso

@{
    ViewData["Title"] = "Cadastrar Curso";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-primary text-white p-3">
                <h4 class="mb-0 fw-bold">➕ Cadastrar Novo Curso</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-bold">Nome do Curso</label>
                        <input asp-for="Nome" class="form-control form-control-lg" placeholder="Ex: Programação C#" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CargaHoraria" class="form-label fw-bold">Carga Horária (horas)</label>
                        <input asp-for="CargaHoraria" class="form-control form-control-lg" placeholder="Ex: 40" />
                        <span asp-validation-for="CargaHoraria" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between align-items-center pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">
                            ← Voltar à Lista
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-4 fw-bold shadow-sm">
                            💾 Guardar Curso
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}