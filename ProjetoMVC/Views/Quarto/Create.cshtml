@model ProjetoMVC.Models.Quarto

@{
    ViewData["Title"] = "Cadastrar Quarto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/quartos.css" asp-append-version="true" />
}

<div class="quarto-page">

    <div class="quarto-card">

        <div class="quarto-header">
            <h1>Cadastrar Quarto</h1>
            <p>Preencha os dados abaixo para adicionar um novo quarto ao hotel.</p>
        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group-custom">
                <label asp-for="Numero" class="form-label-custom">
                    Número do Quarto
                    <span class="campo-obrigatorio">*</span>
                </label>

                <input asp-for="Numero"
                       class="form-control"
                       type="number"
                       placeholder="Ex.: 101" />

                <span asp-validation-for="Numero"
                      class="text-danger"></span>
            </div>

            <div class="form-group-custom">
                <label asp-for="Tipo" class="form-label-custom">
                    Tipo do Quarto
                    <span class="campo-obrigatorio">*</span>
                </label>

                <input asp-for="Tipo"
                       class="form-control"
                       placeholder="Ex.: Standard, Luxo ou Suíte" />

                <span asp-validation-for="Tipo"
                      class="text-danger"></span>
            </div>

            <div class="form-group-custom">
                <label asp-for="ValorDiaria" class="form-label-custom">
                    Valor da Diária
                    <span class="campo-obrigatorio">*</span>
                </label>

                <input asp-for="ValorDiaria"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="Ex.: 150,00" />

                <span asp-validation-for="ValorDiaria"
                      class="text-danger"></span>
            </div>

            <div class="form-group-custom">
                <label asp-for="Status" class="form-label-custom">
                    Status
                    <span class="campo-obrigatorio">*</span>
                </label>

                <input asp-for="Status"
                       class="form-control"
                       placeholder="Ex.: Disponível, Ocupado ou Manutenção" />

                <span asp-validation-for="Status"
                      class="text-danger"></span>
            </div>

            <div class="form-group-custom">

                <button type="submit"
                        class="btn-cadastrar">
                    Cadastrar Quarto
                </button>

            </div>

        </form>

        <div>
            <a asp-action="Index" class="btn-voltar">
                ← Voltar para lista de quartos
            </a>
        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}