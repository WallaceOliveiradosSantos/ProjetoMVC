@model ProjetoMVC.Models.Quarto

@{
    ViewData["Title"] = "Excluir Quarto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/quartos.css" asp-append-version="true" />
}

<div class="quarto-page">

    <div class="quarto-delete">

        <h1>Excluir Quarto</h1>

        <div class="quarto-delete-warning">
            <strong>Atenção!</strong>
            Você está prestes a excluir este quarto.
            Essa ação não poderá ser desfeita.
        </div>

        <div class="quarto-header">
            <p>Confira os dados antes de confirmar a exclusão.</p>
        </div>

        <div class="quarto-info">

            <div class="quarto-info-item">
                <span class="quarto-info-label">
                    Número do Quarto
                </span>

                <span class="quarto-info-value">
                    @Html.DisplayFor(model => model.Numero)
                </span>
            </div>

            <div class="quarto-info-item">
                <span class="quarto-info-label">
                    Tipo
                </span>

                <span class="quarto-info-value">
                    @Html.DisplayFor(model => model.Tipo)
                </span>
            </div>

            <div class="quarto-info-item">
                <span class="quarto-info-label">
                    Valor da Diária
                </span>

                <span class="quarto-info-value">
                    R$ @Html.DisplayFor(model => model.ValorDiaria)
                </span>
            </div>

            <div class="quarto-info-item">
                <span class="quarto-info-label">
                    Status
                </span>

                <span class="quarto-info-value">
                    @Html.DisplayFor(model => model.Status)
                </span>
            </div>

        </div>

        <form asp-action="Delete" class="mt-4">

            <input type="hidden" asp-for="Codigo" />

            <div class="d-flex gap-2 flex-wrap">

                <button type="submit"
                        class="btn-quarto btn-quarto-danger">
                    Excluir Quarto
                </button>

                <a asp-action="Index"
                   class="btn-quarto btn-quarto-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>